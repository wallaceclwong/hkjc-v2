{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dashboard",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/{ping,latest,picks,meetings,reports,prediction,execution,health,debug,subscribe}{,/**}",
        "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
      }
    ],
    "rewrites": [
      {
        "source": "/ping",
        "function": "apiProxy"
      },
      {
        "source": "/latest{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/picks{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/meetings{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/reports{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/prediction{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/execution{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/health{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/debug{,/**}",
        "function": "apiProxy"
      },
      {
        "source": "/subscribe",
        "function": "apiProxy"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
